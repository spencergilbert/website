---
import { resume, byNewest } from '../lib/resume';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';

const hero = resume.basics.hook ?? resume.basics.label;
const experience = byNewest(resume.work);
---

<BaseLayout title="Spencer Gilbert — platform & infrastructure engineer">
  <section class="hero">
    <h1>{hero}</h1>
    <p class="links">
      <a class="button" href="/resume">Resume</a>
      <a href="/spencer-gilbert-cv.pdf">Download PDF</a>
    </p>
  </section>

  <section>
    <h2>Timeline</h2>
    <Timeline entries={experience} story />
  </section>
</BaseLayout>