---
import {
  resume,
  byNewest,
  groupCompanies,
  summaryParagraphs,
} from '../lib/resume';
import BaseLayout from '../layouts/BaseLayout.astro';

const { basics, skills, education } = resume;
const summary = summaryParagraphs(basics);

// Consecutive roles at the same company read as one employer. `resume: false`
// gives a role no line of its own, but its dates still count toward the
// company's overall span — so omitting the roles that weren't distinct work
// doesn't leave a gap.
const companies = groupCompanies(byNewest(resume.work));

interface ContactItem {
  label: string;
  href?: string;
}

const contact: ContactItem[] = [
  ...(basics.email
    ? [{ label: basics.email, href: `mailto:${basics.email}` }]
    : []),
  ...(basics.url
    ? [{ label: basics.url.replace(/^https?:\/\//, ''), href: basics.url }]
    : []),
  ...basics.profiles
    .filter((profile) => profile.url)
    .map((profile) => ({
      label: profile.network,
      href: profile.url ?? undefined,
    })),
];

function formatMonth(value: string): string {
  const date = new Date(`${value}-01T00:00:00Z`);
  return Number.isNaN(date.getTime())
    ? value
    : date.toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });
}

function formatRange(start: string, end?: string | null): string {
  return `${formatMonth(start)} – ${end ? formatMonth(end) : 'Present'}`;
}
---

<BaseLayout
  title="Resume — Spencer Gilbert"
  description="Resume for Spencer Gilbert, platform and infrastructure engineer."
>
  <header class="resume-header">
    <h1>{basics.name}</h1>
    <p class="resume-label">{basics.label}</p>
    <p class="resume-contact">
      {
        contact.map((item, index) => (
          <>
            {index > 0 && (
              <span class="sep" aria-hidden="true">
                ·
              </span>
            )}
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span>{item.label}</span>
            )}
          </>
        ))
      }
    </p>
    <p class="links">
      <a class="button" href="/spencer-gilbert-cv.pdf">Download PDF</a>
    </p>
  </header>

  {
    summary.length > 0 && (
      <section class="resume-section">
        <h2>Summary</h2>
        {summary.map((text) => (
          <p class="resume-summary">{text}</p>
        ))}
      </section>
    )
  }

  <section class="resume-section">
    <h2>Experience</h2>
    <ol class="entries">
      {
        companies.map((company) => (
          <li class="company">
            <div class="company__head">
              <h3 class="company__name">
                {company.name}
                {company.location && (
                  <span class="company__location">{company.location}</span>
                )}
                <span class="company__tenure">
                  {formatRange(company.start, company.end)}
                </span>
              </h3>
            </div>
            <ol class="roles">
              {company.visible.map((role) => (
                <li class="role">
                  <div class="role__head">
                    <h4 class="role__title">{role.position}</h4>
                    {company.roles.length > 1 && (
                      <p class="role__when">
                        {formatRange(role.startDate, role.endDate)}
                      </p>
                    )}
                  </div>
                  {role.highlights.length > 0 && (
                    <ul class="role__points">
                      {role.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </section>

  {
    education.length > 0 && (
      <section class="resume-section">
        <h2>Education</h2>
        <ol class="entries">
          {education.map((item) => (
            <li class="entry">
              <div class="entry__head">
                <h3 class="entry__title">
                  {item.institution}
                  <span class="entry__company">
                    {item.studyType} in {item.area}
                  </span>
                </h3>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section class="resume-section">
        <h2>Technologies</h2>
        <ul class="skills">
          {skills.map((skill) => (
            <li>
              <strong>{skill.name}:</strong> {skill.keywords.join(', ')}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>