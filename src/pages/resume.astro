---
import { resume, byNewest, summaryParagraphs } from '../lib/resume';
import type { Work } from '../lib/resume';
import BaseLayout from '../layouts/BaseLayout.astro';

const { basics, skills, education } = resume;
const summary = summaryParagraphs(basics);

// Consecutive roles at the same company are grouped so a progression reads as
// one employer. `resume: false` gives a role no line of its own, but its dates
// still count toward the company's overall span — so omitting the roles that
// weren't distinct work doesn't leave a gap.
const work = byNewest(resume.work);

interface Company {
  name: string;
  location?: string | null;
  start: string;
  end?: string | null;
  roles: Work[];
  visible: Work[];
}

const companies: Company[] = [];
for (const job of work) {
  const current = companies[companies.length - 1];
  if (current && current.name === job.name) {
    current.roles.push(job);
  } else {
    companies.push({
      name: job.name,
      location: job.location,
      start: job.startDate,
      end: job.endDate,
      roles: [job],
      visible: [],
    });
  }
}

// Roles are newest-first, so the last role starts earliest and the first role
// ends latest. A role without an end date means the company is current.
for (const company of companies) {
  company.start = company.roles[company.roles.length - 1].startDate;
  company.end = company.roles.some((role) => !role.endDate)
    ? null
    : (company.roles[0].endDate ?? null);
  company.location =
    company.roles.find((role) => role.location)?.location ?? null;
  company.visible = company.roles.filter((role) => role.resume);
}

interface ContactItem {
  label: string;
  href?: string;
}

const contact: ContactItem[] = [
  ...(basics.email
    ? [{ label: basics.email, href: `mailto:${basics.email}` }]
    : []),
  ...(basics.url
    ? [{ label: basics.url.replace(/^https?:\/\//, ''), href: basics.url }]
    : []),
  ...basics.profiles
    .filter((profile) => profile.url)
    .map((profile) => ({
      label: profile.network,
      href: profile.url ?? undefined,
    })),
];

function formatMonth(value: string): string {
  const date = new Date(`${value}-01T00:00:00Z`);
  return Number.isNaN(date.getTime())
    ? value
    : date.toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });
}

function formatRange(start: string, end?: string | null): string {
  return `${formatMonth(start)} – ${end ? formatMonth(end) : 'Present'}`;
}
---

<BaseLayout
  title="Resume — Spencer Gilbert"
  description="Resume for Spencer Gilbert, platform and infrastructure engineer."
>
  <header class="resume-header">
    <h1>{basics.name}</h1>
    <p class="resume-label">{basics.label}</p>
    <p class="resume-contact">
      {
        contact.map((item, index) => (
          <>
            {index > 0 && (
              <span class="sep" aria-hidden="true">
                ·
              </span>
            )}
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span>{item.label}</span>
            )}
          </>
        ))
      }
    </p>
    <p class="links">
      <a class="button" href="/spencer-gilbert-cv.pdf">Download PDF</a>
    </p>
  </header>

  {
    summary.length > 0 && (
      <section class="resume-section">
        <h2>Summary</h2>
        {summary.map((text) => (
          <p class="resume-summary">{text}</p>
        ))}
      </section>
    )
  }

  <section class="resume-section">
    <h2>Experience</h2>
    <ol class="entries">
      {
        companies.map((company) => (
          <li class="company">
            <div class="company__head">
              <h3 class="company__name">
                {company.name}
                {company.location && (
                  <span class="company__location">{company.location}</span>
                )}
              </h3>
              {company.visible.length < company.roles.length && (
                <p class="company__when">
                  {formatRange(company.start, company.end)}
                </p>
              )}
            </div>
            <ol class="roles">
              {company.visible.map((role) => (
                <li class="role">
                  <div class="role__head">
                    <h4 class="role__title">{role.position}</h4>
                    <p class="role__when">
                      {formatRange(role.startDate, role.endDate)}
                    </p>
                  </div>
                  {role.highlights.length > 0 && (
                    <ul class="role__points">
                      {role.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </section>

  {
    education.length > 0 && (
      <section class="resume-section">
        <h2>Education</h2>
        <ol class="entries">
          {education.map((item) => (
            <li class="entry">
              <div class="entry__head">
                <h3 class="entry__title">
                  {item.institution}
                  <span class="entry__company">
                    {item.studyType} in {item.area}
                  </span>
                </h3>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section class="resume-section">
        <h2>Technologies</h2>
        <ul class="skills">
          {skills.map((skill) => (
            <li>
              <strong>{skill.name}:</strong> {skill.keywords.join(', ')}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>